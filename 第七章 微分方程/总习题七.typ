#let section-title = [总习题七]

#let problems = (
  // ===== 一、选择题 =====
  (
    kind: "choice",
    stem: [
      设非齐次线性微分方程 $y' + P(x) y = Q(x)$ 有两个不同的解 $y_1(x)$ 与 $y_2(x)$，
      $C$ 为任意常数，则该微分方程的通解是
    ],
    options: (
      [$C[y_1(x) - y_2(x)]$],
      [$y_1(x) + C[y_1(x) - y_2(x)]$],
      [$C[y_1(x) + y_2(x)]$],
      [$y_1(x) + C[y_1(x) + y_2(x)]$],
    ),
    answer: [B],
    solution: [
      $y_1 - y_2$ 是对应齐次方程的解，通解 $=$ 特解 $+$ 齐次通解，
      即 $y = y_1(x) + C[y_1(x) - y_2(x)]$。
      （原题写作 $y'' + P y = Q$，按一阶非齐次线性理解同样结论。）
    ],
  ),
  (
    kind: "choice",
    stem: [
      具有特解 $y_1 = e^(-x)$，$y_2 = 2 x e^(-x)$，$y_3 = 3 e^x$
      的三阶常系数齐次线性微分方程是
    ],
    options: (
      [$y''' - y'' - y' + y = 0$],
      [$y''' + y'' - y' - y = 0$],
      [$y''' - 6 y'' + 11 y' - 6 y = 0$],
      [$y''' - 2 y'' - y' + 2 y = 0$],
    ),
    answer: [B],
    solution: [
      特征根 $-1$（二重）、$1$，特征方程 $(r+1)^2 (r-1) = 0$，
      即 $r^3 + r^2 - r - 1 = 0$，微分方程 $y''' + y'' - y' - y = 0$。
    ],
  ),

  // ===== 二、填空题 =====
  (
    kind: "blank",
    stem: [
      已知 $y = 1$，$y = x$，$y = x^2$ 是某二阶非齐次线性微分方程的三个解，
      则该微分方程的通解为
    ],
    answer: [$1 + C_1(x - 1) + C_2(x^2 - 1)$],
    solution: [
      $x - 1$、$x^2 - 1$ 为对应齐次方程的解，取特解 $1$，
      通解 $y = 1 + C_1(x - 1) + C_2(x^2 - 1)$
      （等价写法 $x + C_1(1 - x) + C_2(1 - x^2)$ 等）。
    ],
  ),

  // ===== 三、计算题 =====
  (
    kind: "compute",
    stem: [求下列微分方程的通解：],
    parts: (
      [$x y' ln x + y = a x (ln x + 1)$；],
      [$y''' + y'' - 2 y' = x(e^x + 4)$。],
    ),
    solution-parts: (
      [
        化为 $y' + y/(x ln x) = a(1 + 1/ln x)$，积分因子 $ln x$，
        得 $y = a x + C / ln x$。
      ],
      [
        （原式若写 $y'' + y''$，按 $y''' + y'' - 2 y'$ 理解。）
        齐次通解 $y_c = C_1 + C_2 e^x + C_3 e^(-2x)$。
        对 $x e^x$ 与 $4x$ 分别设待定特解并叠加，得通解 $y = y_c + y_p$。
      ],
    ),
  ),
  (
    kind: "compute",
    stem: [求下列微分方程满足所给初值条件的特解：],
    parts: (
      [$y^3 dif x + 2(x^2 - x y^2) dif y = 0$，$y|_(x=1) = 1$；],
      [$y'' + y' - 2 y = e^x$，$y|_(x=0) = 1$，$y'|_(x=0) = 2$。],
    ),
    solution-parts: (
      [
        可化为齐次或恰当方程，特解 $y^2 + x^2 = 2x$，即 $(x-1)^2 + y^2 = 1$。
      ],
      [
        通解 $y = C_1 e^x + C_2 e^(-2x) + (1/3) x e^x$。
        初值得 $C_1 = 7/3$，$C_2 = -4/3$，
        特解 $y = (7/3) e^x - (4/3) e^(-2x) + (1/3) x e^x$。
      ],
    ),
  ),
  (
    kind: "compute",
    stem: [
      已知某曲线通过点 $(1,1)$，且该曲线上任意一点处的切线在纵轴上的截距
      等于切点的横坐标，求该曲线方程
    ],
    solution: [
      纵轴截距 $y - x y' = x$，即 $y' = (y - x)/x$。
      令 $u = y/x$，得 $u = -ln|x| + C$，$y = x(C - ln|x|)$。
      由 $(1,1)$ 得 $C = 1$，曲线方程 $y = x(1 - ln x)$。
    ],
  ),
)

#book-section(section-title, problems)
