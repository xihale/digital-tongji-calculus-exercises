#let problems = (
  (
    kind: "choice",
    kind-title: [一、选择题],
    stem: [
      方程 $y^2 + z^2 - 4x + 8 = 0$ 表示
    ],
    options: (
      [单叶双曲面],
      [双叶双曲面],
      [锥面],
      [旋转抛物面],
    ),
    answer: [D],
    solution: [
      原方程可化为 $y^2 + z^2 = 4(x - 2)$。这是由 $x O y$ 面上的抛物线 $y^2 = 4(x - 2)$ 绕 $x$ 轴旋转而得，故为旋转抛物面。
    ],
  ),
  (
    kind: "choice",
    stem: [
      旋转双叶双曲面 $x^2/(a^2) - y^2/(b^2) + z^2/(a^2) = -1$ 的旋转轴是。
    ],
    options: (
      [$x$ 轴],
      [$y$ 轴],
      [$z$ 轴],
      [直线 $cases(y = z, x = 0)$],
    ),
    answer: [B],
    solution: [
      方程中 $x$ 和 $z$ 对应的项系数相同，且与 $y$ 项符号相反。旋转轴是系数符号不同的那个变量所在的轴，即 $y$ 轴。
    ],
  ),
  (
    kind: "blank",
    kind-title: [二、填空题],
    stem: [
      $x O y$ 面上双曲线 $4x^2 - 9y^2 = 36$ 分别绕 $x$ 轴、$y$ 轴旋转一周所得旋转曲面的方程分别为 #blank() 和 #blank()
    ],
    answers: (
      [$4x^2 - 9(y^2 + z^2) = 36$],
      [$4(x^2 + z^2) - 9y^2 = 36$],
    ),
    solution: [
      绕 $x$ 轴旋转：$y^2 arrow y^2+z^2$
          $ 4x^2-9(y^2+z^2)=36 $
          绕 $y$ 轴旋转：$x^2 arrow x^2+z^2$
          $ 4(x^2+z^2)-9y^2=36 $
    ],
  ),
  (
    kind: "blank",
    stem: [
      曲面 $x^2 - y^2 - z^2 = 1$ 是由 $x O y$ 面上的曲线 #blank() 绕 $x$ 轴旋转一周所得的或是由 #blank() 面上的曲线 #blank() 绕 #blank() 轴旋转一周所得的
    ],
    answers: (
      [$x^2 - y^2 = 1$],
      [$z O x$],
      [$x^2 - z^2 = 1$],
      [$x$],
    ),
    solution: [
      方程可记为
          $ x^2 - (y^2+z^2) = 1 $
          令 $z=0$ 得 $x^2-y^2=1$；令 $y=0$ 得 $x^2-z^2=1$。均绕 $x$ 轴旋转。
    ],
