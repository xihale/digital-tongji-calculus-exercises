#let problems = (
  // ===== 一、选择题 =====
  (
    kind: "choice",
    stem: [已知函数 $f(x) = x^4 + a x^2 + b x$ 在点 $x = 1$ 处有极值 $-2$，则常数 $a$、$b$ 的值为],
    options: (
      [$a = -2$，$b = 1$],
      [$a = 1$，$b = -1$],
      [$a = 0$，$b = -3$],
      [$a = -1$，$b = -2$],
    ),
    answer: [D],
    solution: [
      $f(1) = 1 + a + b = -2 => a + b = -3$；
      $f'(x) = 4x^3 + 2a x + b$，$f'(1) = 0 => 4 + 2a + b = 0$。
      联立得 $a = -1$，$b = -2$。
    ],
  ),
  (
    kind: "choice",
    stem: [函数 $y = f(x)$ 在点 $x_0$ 处连续且取得极大值，则],
    options: (
      [$f'(x_0) = 0$],
      [$f''(x_0) < 0$],
      [$f'(x_0) = 0$ 且 $f''(x_0) < 0$],
      [$f'(x_0) = 0$ 或不存在],
    ),
    answer: [D],
    solution: [
      极值点处导数为零或不存在（如尖点），
      不必有 $f'(x_0) = 0$ 或 $f''(x_0) < 0$。故选 D。
    ],
  ),
  (
    kind: "choice",
    stem: [已知 $lim_(x -> a) (f(x) - f(a))/(x - a) = -1$，则在点 $x = a$ 处],
    options: (
      [函数 $f(x)$ 的导数存在且 $f'(a) != 0$],
      [函数 $f(x)$ 取得极小值],
      [函数 $f(x)$ 取得极大值],
      [函数 $f(x)$ 的导数不存在],
    ),
    answer: [A],
    solution: [
      由定义，极限即 $f'(a) = -1$，故导数存在且 $f'(a) != 0$。
      因 $f'(a) != 0$，该点不是极值点。
    ],
  ),
  (
    kind: "choice",
    stem: [曲线 $y = x^2/(1 + x)$ 的渐近线有],
    options: ([2 条], [3 条], [4 条], [5 条]),
    answer: [A],
    solution: [
      铅直渐近线：$x = -1$；
      多项式除法：$y = x - 1 + 1/(1+x)$，斜渐近线 $y = x - 1$。
      共 2 条。
    ],
  ),

  // ===== 二、填空题 =====
  (
    kind: "blank",
    stem: [已知函数 $f(x) = x^2/(1 + x^2)$，其极大值、极小值分别为],
    answers: (
      [无],
      [$0$],
    ),
    solution: [
      $f'(x) = 2x/(1+x^2)^2 = 0 => x = 0$，$f(0) = 0$ 为极小值；
      $x -> oo$ 时 $f -> 1$ 但取不到，无极大值。
    ],
  ),
  (
    kind: "blank",
    stem: [已知函数 $y = x + sqrt(1 - x)$ 在区间 $[-5, 1]$ 上的最大值、最小值分别为],
    answers: (
      [$5/4$],
      [$-5 + sqrt(6)$],
    ),
    solution: [
      $y' = 1 - 1/(2 sqrt(1-x)) = 0 => x = 3/4$，$y(3/4) = 5/4$；
      $y(-5) = -5 + sqrt(6)$，$y(1) = 1$。
      比较得最大值 $5/4$，最小值 $-5 + sqrt(6)$。
    ],
  ),

  // ===== 三、计算题 =====
  (
    kind: "compute",
    stem: [求下列函数的极值：],
    parts: (
      [$y = x - ln(1 + x)$；],
      [$y = 3 - 2(x + 1)^(1/3)$。],
    ),
    solution-parts: (
      [
        $y' = x/(1+x) = 0 => x = 0$（$x > -1$）。
        $x$ 由负变正时 $y'$ 由负变正，极小值 $y(0) = 0$。
      ],
      [
        $y' = -2/3 (x+1)^(-2/3) < 0$（$x != -1$），单调减，无极值。
      ],
    ),
  ),
  (
    kind: "compute",
    stem: [问：函数 $y = x^2 - 54/x$（$x < 0$）在何处取得最小值？],
    solution: [
      $y' = 2x + 54/x^2 = 0 => x^3 = -27 => x = -3$。
      $y''(-3) > 0$，为极小；又 $x < 0$ 上仅此一驻点，故在 $x = -3$ 取得最小值 $y(-3) = 27$。
    ],
  ),
  (
    kind: "compute",
    stem: [描绘下列函数的图形（指出单调性、极值、凹凸与渐近线等）：],
    parts: (
      [$y = 1/5(x^4 - 6x^2 + 8x + 7)$；],
      [$y = x^2 + 1/x$。],
    ),
    solution-parts: (
      [
        四次多项式，$x -> plus.minus oo$ 时 $y -> +oo$。
        $y' = 1/5(4x^3 - 12x + 8)$，求根得极值点；
        $y'' = 1/5(12x^2 - 12)$，拐点 $x = plus.minus 1$。
        据此列表作图。
      ],
      [
        定义域 $x != 0$；铅直渐近线 $x = 0$。
        $y' = 2x - 1/x^2 = 0 => x = root(3, 1/2)$（正），
        该处为极小；负半轴 $y' < 0$ 等，据此作图。
      ],
    ),
  ),
  (
    kind: "compute",
    stem: [
      要造一圆柱形油罐，体积为 $V$，问底半径 $r$ 和高 $h$ 各等于多少时表面积最小？
      这时底直径与高的比是多少？
    ],
    solution: [
      $V = pi r^2 h => h = V/(pi r^2)$，
      $S = 2 pi r^2 + 2 V/r$，$S' = 4 pi r - 2V/r^2 = 0$，
      得 $r = root(3, V/(2 pi))$，$h = 2r$，底直径与高之比 $2r/h = 1$。
    ],
  ),
  (
    kind: "compute",
    stem: [
      一房产公司有 50 套公寓要出租。当月租金定为 4000 元时公寓可全部租出；
      月租金每增加 200 元，就多一套租不出去；租出的公寓每月平均花费 400 元维修费。
      试问月租金定为多少时可获得最大收入？
    ],
    solution: [
      设租金为 $4000 + 200x$ 元，出租 $50 - x$ 套（$0 <= x <= 50$）。
      收入 $I = (50-x)(4000 + 200x - 400) = (50-x)(3600 + 200x)$。
      $I' = 0$ 得 $x = 16$，租金 $4000 + 200 · 16 = 7200$ 元。
    ],
  ),
)

