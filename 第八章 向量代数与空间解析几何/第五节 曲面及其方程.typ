  (
    kind: "blank",
    stem: [
      方程 $4 x^2 + 7 y^2 = z$ 所表示的曲面为
    ],
    answer: [椭圆抛物面],
    solution: [
      标准方程
          $ z =(x^2)/(a^2)+(y^2)/(b^2) $
          ($a,b$ 同号) 表示椭圆抛物面。
    ],
  ),
  (
    kind: "compute",
    kind-title: [三、计算题],
    stem: [
      一球面过坐标原点及三点 $A(4, 0, 0), B(1, 3, 0)$ 和 $C(0, 0, -4)$，求球面的方程及球心的坐标和半径。
    ],
    solution: [
      设
          $ x^2 + y^2 + z^2 + D x + E y + F z + G = 0 $
          过原点 $=> G = 0$。
          代入 $A, B, C$：
          $ 16+4D=0 => D=-4 $
          $ 16-4F=0 => F=4 $
          $ 1+9+D+3E=0 => E=-2 $
          方程：
          $ (x-2)^2+(y-1)^2+(z+2)^2=9 $
          球心 $(2,1,-2)$，半径 3。
    ],
  ),
  (
    kind: "compute",
    stem: [
