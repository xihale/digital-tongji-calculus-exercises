// 数据层：只放内容。公式一律行内。
#import "../lib/render.typ": book-section

#let section-title = [第二节 数列的极限]

#let problems = (
  // ===== 一、选择题 =====
  (
    kind: "choice",
    stem: [下列数列 ${x_n}$ 中，收敛的是],
    options: (
      [$x_n = (-1)^n (n - 1)/n$],
      [$x_n = n/(n + 1)$],
      [$x_n = sin (pi/2 n)$],
      [$x_n = n - (-1)^n$],
    ),
    answer: [B],
    solution: [
      $x_n = n/(n + 1) -> 1$，收敛。
      A 在 $-1$ 与 $1$ 附近振荡，C 为 $sin(n pi/2)$ 振荡，D 发散到无穷。
    ],
  ),
  (
    kind: "choice",
    stem: [下列数列 ${x_n}$ 中，发散的是],
    options: (
      [$x_n = 1/(2^n)$],
      [$x_n = 5 + (-1)^n / n^2$],
      [$x_n = (2n - 1)/(3n + 2)$],
      [$x_n = (1 + (-1)^n)/2$],
    ),
    answer: [D],
    solution: [
      D 在 $0$ 与 $1$ 之间交替，极限不存在。
      A、B、C 分别收敛于 $0$、$5$、$2/3$。
    ],
  ),

  // ===== 二、填空题 =====
  (
    kind: "blank",
    stem: [
      设数列 ${u_n}$ 的一般项是 $u_n = (3n + 1)/(2n + 1)$，
      使不等式 $|u_n - 3/2| < 0.01$ 成立的 $n$ 满足 $n >=$
    ],
    answer: [$25$],
    solution: [
      $|u_n - 3/2| = |(3n + 1)/(2n + 1) - 3/2| = 1/(4n + 2)$。
      由 $1/(4n + 2) < 0.01$ 得 $4n + 2 > 100$，即 $n > 24.5$，
      故 $n >= 25$。
    ],
  ),

  // ===== 三、计算题 =====
  (
    kind: "compute",
    stem: [下列数列是否收敛？若收敛，写出其极限：],
    parts: (
      [${n (-1)^n}$；],
      [${[(-1)^n + 1] (n + 1)/n}$。],
    ),
    solution-parts: (
      [绝对值 $|x_n| = n -> oo$ 且符号交替，故发散。],
      [
        $n$ 为奇数时 $x_n = 0$；$n$ 为偶数时 $x_n = 2(n + 1)/n -> 2$。
        在 $0$ 与趋近于 $2$ 的值之间振荡，不收敛。
      ],
    ),
  ),

  // ===== 四、证明题 =====
  (
    kind: "proof",
    stem: [根据数列极限的定义，证明：],
    parts: (
      [$lim_(n -> oo) 1/n^2 = 0$；],
      [$lim_(n -> oo) (3n + 1)/(2n + 1) = 3/2$；],
      [$lim_(n -> oo) (n^2 - n - 3)/(3n^2 + 2n - 4) = 1/3$；],
      [
        若 $lim_(n -> oo) x_n = a$，则 $lim_(n -> oo) |x_n| = |a|$。
        反过来成立吗？成立给出证明，不成立举出反例。
      ],
    ),
    solution-parts: (
      [
        对任意 $epsilon > 0$，取 $N = 1/sqrt(epsilon)$，
        当 $n > N$ 时 $|1/n^2 - 0| = 1/n^2 < epsilon$，故极限为 $0$。
      ],
      [
        $|(3n + 1)/(2n + 1) - 3/2| = 1/(2(2n + 1))$。
        对任意 $epsilon > 0$，取 $N = 1/(4epsilon) - 1/2$，
        当 $n > N$ 时上式 $< epsilon$，故极限为 $3/2$。
      ],
      [
        分子分母同除以 $n^2$ 得
        $(1 - 1/n - 3/n^2)/(3 + 2/n - 4/n^2)$。
        由极限运算法则（或 $epsilon$-$N$ 定义）知其极限为 $1/3$。
      ],
      [
        由绝对值不等式 $||x_n| - |a|| <= |x_n - a|$，
        若 $x_n -> a$ 则 $|x_n| -> |a|$。
        反过来不成立：取 $x_n = (-1)^n$，则 $|x_n| = 1 -> 1$，但 ${x_n}$ 发散。
      ],
    ),
  ),
)

#book-section(section-title, problems)
