#let section-title = [第四节 函数的单调性与曲线的凹凸性]

#let problems = (
  // ===== 一、选择题 =====
  (
    kind: "choice",
    stem: [
      设函数 $f(x)$、$g(x)$ 在区间 $[a, b]$ 上可导，且 $f'(x) > g'(x)$，
      则在 $(a, b)$ 内有
    ],
    options: (
      [$f(x) - g(x) > 0$],
      [$f(x) - g(x) >= 0$],
      [$f(x) - g(x) > f(b) - g(b)$],
      [$f(x) - g(x) > f(a) - g(a)$],
    ),
    answer: [D],
    solution: [
      令 $h = f - g$，则 $h' > 0$，$h$ 严格递增。
      对 $x in (a,b)$ 有 $h(x) > h(a)$，即 $f(x)-g(x) > f(a)-g(a)$。
    ],
  ),
  (
    kind: "choice",
    stem: [设函数 $f(x) = |x(1 - x)|$，则],
    options: (
      [$x = 0$ 是 $f(x)$ 的极值点，但 $(0,0)$ 不是曲线 $y = f(x)$ 的拐点],
      [$x = 0$ 不是 $f(x)$ 的极值点，但 $(0,0)$ 是曲线 $y = f(x)$ 的拐点],
      [$x = 0$ 是 $f(x)$ 的极值点，且 $(0,0)$ 是曲线 $y = f(x)$ 的拐点],
      [$x = 0$ 不是 $f(x)$ 的极值点，$(0,0)$ 也不是曲线 $y = f(x)$ 的拐点],
    ),
    answer: [A],
    solution: [
      $f(x) = |x - x^2| >= 0$ 且 $f(0) = 0$，故 $x = 0$ 为极小值点。
      $x = 0$ 处不可导，$(0,0)$ 不是拐点。故选 A。
    ],
  ),
  (
    kind: "choice",
    stem: [曲线 $y = (x - 1)^2 (x - 3)^2$ 的拐点个数是],
    options: ([0], [1], [2], [3]),
    answer: [C],
    solution: [
      $y' = 4(x-1)(x-3)(x-2)$，
      $y'' = 4[3x^2 - 12x + 11]$。
      令 $y'' = 0$：$3x^2 - 12x + 11 = 0$，判别式 $12 > 0$，两相异实根，
      且 $y''$ 在两根处变号，故有 2 个拐点。
    ],
  ),

  // ===== 二、填空题 =====
  (
    kind: "blank",
    stem: [函数 $y = 10/(4x^3 - 9x^2 + 6x)$ 的单调增加区间是],
    answer: [$(1/2, 1)$],
    solution: [
      定义域 $x != 0$。$y' = -60(2x-1)(x-1)/(4x^3-9x^2+6x)^2$，
      分母平方恒正（$x != 0$），故 $y'$ 与 $-(2x-1)(x-1)$ 同号。
      在 $(1/2, 1)$ 上 $y' > 0$，为单调增加区间。
    ],
  ),
  (
    kind: "blank",
    stem: [曲线 $y = x e^(-x)$ 的凹区间是],
    answer: [$(2, +oo)$],
    solution: [
      $y' = (1-x)e^(-x)$，$y'' = (x-2)e^(-x)$。
      $y'' > 0$ 当且仅当 $x > 2$，故凹区间为 $(2, +oo)$。
    ],
  ),
  (
    kind: "blank",
    stem: [设点 $(1, 3)$ 为曲线 $y = a x^3 + b x^2$ 的拐点，则 $a$、$b$ 分别为],
    answers: (
      [$-3/2$],
      [$9/2$],
    ),
    solution: [
      $y'' = 6a x + 2b$，拐点横坐标 $x = 1$ 得 $6a + 2b = 0$，即 $b = -3a$。
      点在曲线上：$a + b = 3$，联立得 $a = -3/2$，$b = 9/2$。
    ],
  ),

  // ===== 三、计算题 =====
  (
    kind: "compute",
    stem: [判定函数 $f(x) = x + cos x$ 的单调性],
    solution: [
      $f'(x) = 1 - sin x >= 0$，且在任一区间上不恒为零，
      故 $f$ 在 $(-oo, +oo)$ 上严格递增。
    ],
  ),
  (
    kind: "compute",
    stem: [求下列函数的单调区间：],
    parts: (
      [$y = 2x^3 - 6x^2 - 18x - 7$；],
      [$y = root(3, (2x - a)(a - x)^2)$（$a > 0$）。],
    ),
    solution-parts: (
      [
        $y' = 6(x-3)(x+1)$。
        增区间：$(-oo, -1)$、$(3, +oo)$；减区间：$(-1, 3)$。
      ],
      [
        令 $u = (2x-a)(a-x)^2$，则 $y = u^(1/3)$，
        $u' = 2(a-x)(2a-3x)$，$y'$ 与 $u'$ 同号（$u != 0$）。
        关键点 $x = 2a/3$、$x = a$（$x = a/2$ 处 $y = 0$ 可能有铅直切线）。
        增区间：$(-oo, 2a/3)$、$(a, +oo)$；减区间：$(2a/3, a)$。
      ],
    ),
  ),
  (
    kind: "compute",
    stem: [求下列函数曲线的拐点及凹凸区间：],
    parts: (
      [$y = x^3 - 5x^2 + 3x + 5$；],
      [$y = ln(x^2 + 1)$。],
    ),
    solution-parts: (
      [
        $y'' = 6x - 10 = 0 => x = 5/3$，$y(5/3) = 20/27$。
        拐点 $(5/3, 20/27)$；凸区间 $(-oo, 5/3)$，凹区间 $(5/3, +oo)$。
      ],
      [
        $y'' = 2(1 - x^2)/(x^2+1)^2 = 0 => x = plus.minus 1$。
        拐点 $(plus.minus 1, ln 2)$；凹区间 $(-1, 1)$，凸区间 $(-oo, -1)$、$(1, +oo)$。
      ],
    ),
  ),
  (
    kind: "compute",
    stem: [
      试确定曲线 $y = a x^3 + b x^2 + c x + d$ 中的 $a, b, c, d$，
      使得 $x = -2$ 处曲线有水平切线，$(1, -10)$ 为其拐点，且点 $(-2, 44)$ 在曲线上
    ],
    solution: [
      $y'(-2) = 0$：$12a - 4b + c = 0$；
      $y''(1) = 0$：$b = -3a$；
      $(1,-10)$ 在曲线上：$a + b + c + d = -10$；
      $(-2,44)$ 在曲线上：$-8a + 4b - 2c + d = 44$。
      解得 $a = 1$，$b = -3$，$c = -24$，$d = 16$。
    ],
  ),

  // ===== 四、证明题 =====
  (
    kind: "proof",
    stem: [证明下列不等式：],
    parts: (
      [当 $x > 0$ 时，$1 + x/2 > sqrt(1 + x)$；],
      [当 $0 < x < pi/2$ 时，$sin x + tan x > 2x$。],
    ),
    solution-parts: (
      [
        令 $f(x) = 1 + x/2 - sqrt(1+x)$，则 $f(0) = 0$，
        $f'(x) = (sqrt(1+x) - 1)/(2 sqrt(1+x)) > 0$（$x > 0$），故 $f(x) > 0$。
      ],
      [
        令 $f(x) = sin x + tan x - 2x$，则 $f(0) = 0$，$f'(0) = 0$，
        $f''(x) = -sin x + 2 sec^2 x tan x$。
        当 $0 < x < pi/2$ 时 $f''(x) > 0$，故 $f' > 0$、$f > 0$。
      ],
    ),
  ),
)

