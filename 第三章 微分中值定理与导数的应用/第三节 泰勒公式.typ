  // ===== 一、选择题 =====
  (
    kind: "choice",
    stem: [已知 $cos x = 1 - x^2/2 + R_3(x)$，则 $R_3(x) =$],
    options: (
      [$(sin xi)/3! · x^3$],
      [$-(sin xi)/3! · x^3$],
      [$(cos xi)/4! · x^4$],
      [$-(cos xi)/4! · x^4$],
    ),
    answer: [C],
    solution: [
      $cos x$ 的麦克劳林展开中 $x^3$ 项系数为 0，
      三阶泰勒公式的拉格朗日余项为 $R_3(x) = (cos xi)/4! · x^4$。
    ],
  ),
  (
    kind: "choice",
    stem: [
      函数 $f(x)$ 的泰勒展开式 $f(x) = sum_(k=0)^n a_k (x - x_0)^k + R_n(x)$ 中，
      拉格朗日余项 $R_n(x) =$
    ],
    options: (
      [$f^((n+1))(theta x)/((n+1)!) (x - x_0)^(n+1)$（$0 < theta < 1$）],
      [$f^((n+1))(x_0 + theta x)/((n+1)!) (x - x_0)^(n+1)$（$0 < theta < 1$）],
      [$f^((n+1))(x_0 + theta(x - x_0))/((n+1)!) (x - x_0)^n$（$0 < theta < 1$）],
